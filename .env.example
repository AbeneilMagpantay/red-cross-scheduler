# Environment variables for Supabase
# Copy this file to .env.local and fill in your Supabase credentials

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public Web Push key generated with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Configure these as Supabase Edge Function secrets (never VITE_ variables):
# VAPID_PUBLIC_KEY=the_same_public_key
# VAPID_PRIVATE_KEY=your_private_key
# VAPID_SUBJECT=mailto:your-admin-email@example.com
